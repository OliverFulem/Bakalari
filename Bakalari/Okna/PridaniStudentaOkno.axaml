<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bakalari.Okna.PridaniStudentaOkno"
        Width="520"
        SizeToContent="Height"
        Title="Nový student"
        Icon="avares://Bakalari/icon-letter-b-100.png"
        Background="{DynamicResource PanelPozadi}">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2D5A27"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="30" Spacing="15">
        <TextBlock Text="Nový student" FontSize="24" FontWeight="Bold" Foreground="#2D5A27"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Jméno:" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox Name="NameTextBox" PlaceholderText="Zadejte jméno" FontSize="16"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Příjmení:" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox Name="SurnameTextBox" PlaceholderText="Zadejte příjmení" FontSize="16"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Třída:" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
            <ComboBox Name="ClassComboBox" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Name="ImportButton" Content="Importovat ze souboru (.txt)" Background="#555" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Name="AddButton" Content="Přidat" Width="100"/>
            <Button Grid.Column="2" Name="CloseButton" Content="Zavřít" Background="#888" Width="100"/>
        </Grid>

        <TextBlock Name="StatusText" FontSize="12" Foreground="{DynamicResource TextHint}"/>
    </StackPanel>
</Window>
