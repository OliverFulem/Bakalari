<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tridy="clr-namespace:Bakalari.Tridy"
        x:Class="Bakalari.Okna.PodrobnostiStudentaOkno"
        Width="700"
        Height="700"
        Title="Detail studenta"
        Background="#F4F4F9">

    <Window.Styles>
        <Style Selector="Border.ohrozen">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#EF9A9A"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#E57373"/>
        </Style>

        <!-- Vizuální stav vybraného předmětu – zelený rámeček a světlé pozadí -->
        <Style Selector="Border.vybrano">
            <Setter Property="BorderBrush" Value="#2D5A27"/>
            <Setter Property="Background" Value="#E8F5E9"/>
        </Style>
        <!-- Pokud je předmět ohrožen A zároveň vybrán, zvýrazníme červeně -->
        <Style Selector="Border.ohrozen.vybrano">
            <Setter Property="BorderBrush" Value="#C62828"/>
        </Style>

        <!-- Potlačíme výchozí modré zvýraznění výběru ListBoxu – stav řídíme sami přes Border.vybrano -->
        <Style Selector="ListBox#SubjectAveragesListBox ListBoxItem">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox#SubjectAveragesListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#SubjectAveragesListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <StackPanel Spacing="5">
                <TextBlock Text="Karta studenta" FontSize="28" FontWeight="Bold" Foreground="#2D5A27"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Name="JmenoText" FontSize="18" Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="Třída:" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>
                        <ComboBox Name="ClassComboBox" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Name="DeleteStudentButton" Content="Smazat studenta" Classes="danger" VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">

                <!-- Celkový průměr a varování -->
                <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 5 0 #15000000">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <StackPanel>
                            <TextBlock Text="Celkový průměr:" FontSize="14" Foreground="#777"/>
                            <TextBlock Name="PrumerText" FontSize="36" FontWeight="ExtraBold" Foreground="#2D5A27"/>
                        </StackPanel>
                        <Border Name="WarningBorder"
                                Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="1"
                                CornerRadius="4" Padding="10" VerticalAlignment="Center" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M12 2L1 21h22L12 2zm0 3.45L19.53 19H4.47L12 5.45zM11 16h2v2h-2v-2zm0-6h2v4h-2v-4z"
                                      Fill="#F57C00" Width="20" Height="20" Stretch="Uniform"/>
                                <TextBlock Text="PROSPĚCH OHROŽEN" VerticalAlignment="Center"
                                           Foreground="#E65100" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Průměry podle předmětů – kliknutím se filtruje historie -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Průměry podle předmětů:" FontSize="16" FontWeight="Bold" Foreground="#555"/>
                    <TextBlock Text="(kliknutím filtrujte historii)" FontSize="12" Foreground="#999" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox Name="SubjectAveragesListBox"
                         SelectionMode="Multiple,Toggle"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="tridy:SubjectAverage">
                            <Border Margin="0,0,0,8" Padding="15,10" Background="White" CornerRadius="6"
                                    BorderThickness="2" BorderBrush="#EEE" Cursor="Hand"
                                    Classes.ohrozen="{Binding JeOhrozen}"
                                    Classes.vybrano="{Binding $parent[ListBoxItem].IsSelected}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{Binding Predmet}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Prumer, StringFormat={}{0:0.00}}"
                                               FontSize="18" FontWeight="Bold" Foreground="#2D5A27"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Historie známek – nadpis se mění podle aktivního filtru -->
                <TextBlock Name="ZnamkyNadpis" Text="Historie všech známek:"
                           FontSize="16" FontWeight="Bold" Foreground="#555"/>
                <Border Background="White" CornerRadius="8" Padding="10" BoxShadow="0 2 5 0 #15000000">
                    <ListBox Name="ZnamkyListBox" MaxHeight="300" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tridy:Znamka">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Center" Spacing="1">
                                        <Border Width="30" Height="30" CornerRadius="15" Tag="{Binding Hodnota}">
                                            <Border.Styles>
                                                <Style Selector="Border">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                </Style>
                                                <Style Selector="Border[Tag=5]">
                                                    <Setter Property="Background" Value="#E57373"/>
                                                </Style>
                                                <Style Selector="Border[Tag=5] TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Text="{Binding Hodnota}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding VahaText}" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Predmet.Nazev}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MetadataText}" FontSize="11" Foreground="#888" FontStyle="Italic"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Smazat" Background="#E57373" Foreground="White" FontSize="10"
                                            Click="DeleteMark_Click" Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Name="CloseButton" Content="Zavřít"
                HorizontalAlignment="Right" Width="100" Margin="0,20,0,0"
                Background="#2D5A27" Foreground="White"/>

    </Grid>
</Window>
