<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tridy="clr-namespace:Bakalari.Tridy"
        x:Class="Bakalari.Okna.NastaveniSkolyOkno"
        Width="500"
        SizeToContent="Height"
        MinHeight="400"
        Title="Nastavení školy"
        Background="#F9F9F9">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2D5A27"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="30" Spacing="20">
        <TextBlock Text="Nastavení školy" FontSize="24" FontWeight="Bold" Foreground="#2D5A27"/>

        <!-- Classes -->
        <StackPanel Spacing="10">
            <TextBlock Text="Správa tříd:" FontWeight="SemiBold" FontSize="16"/>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <TextBox Name="NewClassTextBox" PlaceholderText="Nová třída (např. 3.B)"/>
                <Button Grid.Column="1" Name="AddClassButton" Content="Přidat"/>
            </Grid>
            <ListBox Name="ClassesListBox" Height="120">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="tridy:TridaInfo">
                        <TextBlock Text="{Binding Nazev}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Name="DeleteClassButton" Content="Smazat vybranou" Background="#E57373" HorizontalAlignment="Right"/>
        </StackPanel>

        <Separator/>

        <!-- Subjects per Class -->
        <StackPanel Spacing="10">
            <TextBlock Text="Předměty pro vybranou třídu:" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Text="Změny se aplikují na třídu vybranou v seznamu výše." FontSize="12" FontStyle="Italic" Foreground="#666"/>
            
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <TextBox Name="NewSubjectTextBox" PlaceholderText="Nový předmět..."/>
                <Button Grid.Column="1" Name="AddSubjectButton" Content="Přidat"/>
            </Grid>
            <ListBox Name="SubjectsListBox" Height="150"/>
            <Button Name="DeleteSubjectButton" Content="Smazat předmět" Background="#E57373" HorizontalAlignment="Right"/>
        </StackPanel>

        <Separator/>

        <!-- Data export / import -->
        <StackPanel Spacing="10">
            <TextBlock Text="Záloha a obnova dat:" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Text="Export uloží veškerá data do JSON souboru. Import data nahradí." FontSize="12" FontStyle="Italic" Foreground="#666"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Name="ExportDataButton" Content="Exportovat data (.json)" Background="#1565C0" Width="200"/>
                <Button Name="ImportDataButton" Content="Importovat data (.json)" Background="#0D47A1" Width="200"/>
            </StackPanel>
            <TextBlock Name="DataStatusText" FontSize="12" Foreground="#555"/>
        </StackPanel>

        <Button Name="CloseButton" Content="Zavřít a uložit" HorizontalAlignment="Center" Width="200" Margin="0,10,0,0"/>
    </StackPanel>
</Window>